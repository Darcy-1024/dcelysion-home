{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dcelysion-home",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "dcelysion.cn",
      "custom_domain": true
    },
    {
      "pattern": "home.dcelysion.cn",
      "custom_domain": true
    }
  ]
}
